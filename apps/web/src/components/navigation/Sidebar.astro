---
import "./sidebar.css";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  {
    label: "Inicio",
    href: "/",
  },
  {
    label: "Explorar",
    href: "/explorar",
  },
  {
    label: "Tu biblioteca",
    href: "/biblioteca",
  },
];
---

<aside class="sidebar scrollable">
  <a
    class="sidebar-brand"
    href="/"
    aria-label="Lelyfy, inicio"
  >
    <span class="sidebar-brand-symbol" aria-hidden="true">
      ♫
    </span>

    <span>Lelyfy</span>
  </a>

  <nav
    class="sidebar-nav"
    aria-label="Navegación principal"
  >
    {
      links.map((link) => {
        const isActive =
          link.href === "/"
            ? currentPath === "/"
            : currentPath === link.href ||
              currentPath.startsWith(`${link.href}/`);

        return (
          <a
            class:list={[
              "sidebar-link",
              { "sidebar-link--active": isActive },
            ]}
            href={link.href}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>

  <p class="sidebar-caption">
    Un espacio para tu música.
  </p>
</aside>