---
import "./sidebar.css";
---

<aside class="sidebar scrollable">
  <a
    class="sidebar-brand"
    href="/"
    aria-label="Lelyfy, inicio"
  >
    <span class="sidebar-brand-symbol" aria-hidden="true">
      ♫
    </span>

    <span>Lelyfy</span>
  </a>

  <nav
    class="sidebar-nav"
    aria-label="Navegación principal"
  >
    <a
      class="sidebar-link sidebar-link--active"
      href="/"
      aria-current="page"
    >
      Inicio
    </a>

    <a class="sidebar-link" href="/#explorar">
      Explorar
    </a>

    <a class="sidebar-link" href="/#biblioteca">
      Tu biblioteca
    </a>
  </nav>

  <p class="sidebar-caption">
    Un espacio para tu música.
  </p>
</aside>