---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/home.css";

const sections = [
  {
    title: "Artistas",
    description: "Descubre las voces detrás de tus canciones.",
    symbol: "♫",
    color: "purple",
  },
  {
    title: "Lanzamientos",
    description: "Singles, EPs y álbumes por descubrir.",
    symbol: "◈",
    color: "blue",
  },
  {
    title: "Playlists",
    description: "Un lugar para cada momento y cada canción.",
    symbol: "✦",
    color: "pink",
  },
];
---

<BaseLayout title="Inicio">
  <div class="home-page">
    <header class="home-topbar">
      <span class="home-topbar-label">
        TU ESPACIO MUSICAL
      </span>

      <span class="home-badge">
        Lelyfy
      </span>
    </header>

    <section
      class="home-hero"
      aria-labelledby="hero-title"
    >
      <p class="home-eyebrow">
        DALE PLAY A LO QUE SIENTES
      </p>

      <h1 id="hero-title" class="home-title">
        Tu música.<br />
        <span>Tu propio mundo.</span>
      </h1>

      <p class="home-description">
        Descubre artistas, encuentra nuevas canciones y reúne
        todo lo que te gusta en un mismo lugar.
      </p>

      <a
        class="home-primary-button"
        href="#explorar"
      >
        Explorar
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section
      id="explorar"
      class="home-section"
      aria-labelledby="explore-title"
    >
      <div class="home-section-heading">
        <p class="home-eyebrow">
          EXPLORA LELYFY
        </p>

        <h2
          id="explore-title"
          class="home-section-title"
        >
          Hecho para escuchar
        </h2>
      </div>

      <div class="home-cards">
        {
          sections.map((section) => (
            <article class="home-card">
              <div
                class:list={[
                  "home-card-art",
                  `home-card-art--${section.color}`,
                ]}
                aria-hidden="true"
              >
                {section.symbol}
              </div>

              <h3 class="home-card-title">
                {section.title}
              </h3>

              <p class="home-card-description">
                {section.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="biblioteca"
      class="home-section home-library"
      aria-labelledby="library-title"
    >
      <span
        class="home-library-symbol"
        aria-hidden="true"
      >
        ♫
      </span>

      <h2
        id="library-title"
        class="home-section-title"
      >
        Aquí comenzará tu colección
      </h2>

      <p class="home-library-description">
        Tus canciones favoritas y playlists tendrán su lugar aquí.
      </p>
    </section>
  </div>
</BaseLayout>